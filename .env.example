NODE_ENV=development
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3000
PORT=3000

# Ephemeral KV State (metadata only, never file contents)
# In-Memory only for local development / a single persistent server.
# Vercel deployments REQUIRE a shared Upstash REST URL and write token.
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# REDIS_URL alone is not supported by the REST adapter.

SESSION_SIGNING_SECRET=replace-with-64-byte-csprng-hex-secret-for-session-signing
ROOM_CODE_HMAC_SECRET=replace-with-independent-64-byte-csprng-hex-secret-for-room-hmac
ROOM_JOIN_TTL_SECONDS=300
ROOM_PENDING_TTL_SECONDS=300
ROOM_CONNECTED_TTL_SECONDS=7200

# WebRTC STUN/TURN (Google STUN is included by default)
# Optional Managed TURN (e.g. Metered.ca 50GB free tier or custom TURN)
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_USERNAME=your-turn-username
# TURN_CREDENTIAL=your-turn-credential

# Optional Real-time Push Signaling (Pusher Channels - free tier 200k msgs/day)
# If not set, NexaShare automatically falls back to fast HTTP signal polling!
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=
# PUSHER_CLUSTER=ap1

RATE_JOIN_LIMIT=5
RATE_JOIN_WINDOW_SECONDS=300
LOG_LEVEL=info
